# Salin file ini menjadi .env.local, lalu isi nilainya dari dashboard Supabase.
# JANGAN commit .env.local. File ini hanya berisi placeholder.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Hanya untuk scripts/generate.ts (server/script). Jangan pernah dipakai
# di kode client, dan jangan pernah ditempel di chat atau commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
